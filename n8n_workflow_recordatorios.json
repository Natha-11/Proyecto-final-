      "id": "cron-diario",
      "name": "Trigger Diario 9:00 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://localhost/Proyecto_final6t0/nombre-proyecto/api_reservations.php",
        "authentication": "none",
        "requestMethod": "GET",
        "options": {}
      },
      "id": "http-get-reservas",
      "name": "Obtener Reservas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "functionCode": "// Filtrar solo las reservas de mañana\nconst hoy = new Date();\nconst mañana = new Date(hoy);\nmañana.setDate(mañana.getDate() + 1);\n\nconst mañanaStr = mañana.toISOString().split('T')[0]; // YYYY-MM-DD\n\nconst reservas = $input.all();\nconst reservasMañana = [];\n\nfor (const item of reservas) {\n  const reserva = item.json;\n  if (Array.isArray(reserva)) {\n    // Si es un array de reservas\n    for (const r of reserva) {\n      if (r.fecha === mañanaStr) {\n        reservasMañana.push({\n          json: {\n            ...r,\n            fecha_formateada: new Date(r.fecha + 'T00:00:00').toLocaleDateString('es-ES', {\n              weekday: 'long',\n              year: 'numeric',\n              month: 'long',\n              day: 'numeric'\n            })\n          }\n        });\n      }\n    }\n  } else if (reserva.fecha === mañanaStr) {\n    reservasMañana.push({\n      json: {\n        ...reserva,\n        fecha_formateada: new Date(reserva.fecha + 'T00:00:00').toLocaleDateString('es-ES', {\n          weekday: 'long',\n          year: 'numeric',\n          month: 'long',\n          day: 'numeric'\n        })\n      }\n    });\n  }\n}\n\nreturn reservasMañana;"
      },
      "id": "function-filtrar-mañana",
      "name": "Filtrar Reservas de Mañana",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$input.all().length}}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "if-hay-reservas",
      "name": "¿Hay Reservas Mañana?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batches",
      "name": "Loop por Cada Reserva",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "fromEmail": "recordatorios@glowbelleza.com",
        "toEmail": "={{$json.email || 'cliente@example.com'}}",
        "subject": "🌟 Recordatorio: Tu cita mañana en Glow Belleza",
        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: 'Arial', sans-serif; background: #f5f5f5; padding: 20px; }\n    .container { max-width: 600px; margin: 0 auto; background: white; border-radius: 10px; overflow: hidden; }\n    .header { background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%); color: #d4af37; padding: 30px; text-align: center; }\n    .content { padding: 30px; }\n    .reminder-box { background: #fff9e6; border: 2px solid #d4af37; border-radius: 8px; padding: 20px; margin: 20px 0; text-align: center; }\n    .big-time { font-size: 36px; color: #d4af37; font-weight: bold; margin: 10px 0; }\n    .footer { background: #2c2c2c; color: #999; padding: 20px; text-align: center; font-size: 12px; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>✨ Glow Belleza</h1>\n      <p style=\"margin: 10px 0 0 0; color: #fff;\">Recordatorio de Cita</p>\n    </div>\n    <div class=\"content\">\n      <h2>¡Hola {{$json.nombre_cliente}}!</h2>\n      <p>Este es un recordatorio amistoso de que tienes una cita mañana con nosotros.</p>\n      \n      <div class=\"reminder-box\">\n        <p style=\"margin: 0; color: #666; font-size: 14px;\">TU CITA ES MAÑANA</p>\n        <div class=\"big-time\">{{$json.hora}}</div>\n        <p style=\"margin: 10px 0 0 0; font-weight: bold;\">{{$json.fecha_formateada}}</p>\n        <p style=\"margin: 15px 0 0 0; color: #666;\">Servicio: <strong>{{$json.servicio}}</strong></p>\n      </div>\n      \n      <p>Te esperamos puntualmente. Si necesitas cancelar o reprogramar, por favor contáctanos lo antes posible.</p>\n      \n      <p style=\"margin-top: 30px; text-align: center; color: #999; font-size: 14px;\">¡Nos vemos pronto! 💄</p>\n    </div>\n    <div class=\"footer\">\n      © 2026 Glow Belleza | info@glowbelleza.com | 123 456 7890\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
