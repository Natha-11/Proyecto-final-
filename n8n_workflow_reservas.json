      "id": "webhook-trigger",
      "name": "Webhook Trigger - Recibir Eventos",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "24a76578-55f8-421c-b5c6-f754e82b3a53"
    },
    {
      "parameters": {
        "functionCode": "// Validar y procesar datos recibidos\nconst evento = $input.item.json.evento || 'desconocido';\nconst datos = $input.item.json.datos || {};\n\n// Agregar metadata\nconst processed = {\n  evento: evento,\n  datos: datos,\n  timestamp_recibido: new Date().toISOString(),\n  origen: $input.item.json.origen || 'unknown',\n  procesado: true\n};\n\n// Validaciones específicas por tipo de evento\nif (evento === 'nueva_reserva') {\n  // Validar campos obligatorios\n  const camposRequeridos = ['nombre', 'servicio', 'fecha', 'hora'];\n  const faltantes = camposRequeridos.filter(campo => !datos[campo]);\n  \n  if (faltantes.length > 0) {\n    processed.error = `Campos faltantes: ${faltantes.join(', ')}`;\n    processed.valido = false;\n  } else {\n    processed.valido = true;\n    \n    // Formatear datos para notificación\n    processed.notificacion = {\n      asunto: `Nueva Reserva - ${datos.servicio}`,\n      cliente: datos.nombre,\n      servicio: datos.servicio,\n      fecha: datos.fecha,\n      hora: datos.hora,\n      codigo: datos.codigo_confirmacion || 'N/A'\n    };\n  }\n} else if (evento === 'nuevo_usuario') {\n  processed.valido = datos.email && datos.nombre;\n  processed.notificacion = {\n    asunto: 'Nuevo Usuario Registrado',\n    email: datos.email,\n    nombre: datos.nombre\n  };\n}\n\nreturn processed;"
      },
      "id": "function-validacion",
      "name": "Validar y Procesar Datos",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.evento}}",
              "value2": "nueva_reserva"
